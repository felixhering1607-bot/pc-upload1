# ============================================================
# Kopiere diese Datei zu ".env" und trage deine eigenen Werte ein.
# Die .env darf NIEMALS zu GitHub gepusht werden!
# ============================================================

# --- Backend Grundeinstellungen ---
# Zufälliger, langer geheimer String zum Signieren der Login-Tokens.
# Generieren z.B. mit: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_long_random_string

# Login-Zugangsdaten fuer die Weboberflaeche
AUTH_USERNAME=felix

# Passwort NICHT im Klartext speichern - Hash erzeugen mit:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('DEIN_PASSWORT'))"
AUTH_PASSWORD_HASH=changeme_password_hash

# Ein zweites, eigenes Geheimnis nur fuer den PC-Client und den Relay,
# damit diese sich beim Backend authentifizieren koennen (kein Mensch tippt das).
# Generieren z.B. mit: python -c "import secrets; print(secrets.token_hex(32))"
DEVICE_TOKEN=changeme_generate_another_long_random_string

# --- CORS ---
# Die genaue URL deiner GitHub-Pages-Seite, z.B. https://felix123.github.io
ALLOWED_ORIGIN=https://DEIN-GITHUB-NAME.github.io

# --- Wake-on-LAN ---
# MAC-Adresse deines PCs (siehe README zur WoL-Architektur - dieser Wert
# darf ausschliesslich hier, niemals im Frontend stehen!)
PC_MAC_ADDRESS=2C-F0-5D-5D-37-AA

# Broadcast-Adresse deines lokalen Netzwerks (i.d.R. 255.255.255.255,
# oder z.B. 192.168.1.255 - siehe README)
LAN_BROADCAST_IP=255.255.255.255

# --- Datei-Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=500
# Kommagetrennte Liste erlaubter Dateiendungen, leer lassen = alle erlaubt
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,mp4,mov,mkv,pdf,zip,doc,docx,txt,mp3

# --- Ziel-Ordner auf dem Windows-PC (wird vom PC-Client benutzt) ---
PC_DOWNLOAD_DIR=C:\Users\felix\Uploads
